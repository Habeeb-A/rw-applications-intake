# ---------------------------------------------------------------------------
# Copy to .env.local and fill in from your Supabase project:
#   Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------

# Safe to expose to the browser. Row Level Security is what protects the data,
# not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER expose this one. It carries BYPASSRLS and would defeat every policy in
# this repo. Used only by scripts/seed.ts and scripts/verify-acceptance.ts,
# which run on your machine, never in the browser or in a deployed function.
# Do not add this to Netlify's environment variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by the seed script and by the acceptance-criteria verifier.
SEED_STAFF_PASSWORD=staff-trial-password
SEED_APPLICANT_PASSWORD=applicant-trial-password
